# Copy this file to .env and add your own Ticketmaster key (enables the
# find_events tool; without it the agent builds SideQuests without live events).
TICKETMASTER_API_KEY=

# Optional: enables Google Places Text Search. Without it, Reality uses the
# curated NYC dataset in data/nyc_places.json.
GOOGLE_MAPS_API_KEY=

# Optional Gemini configuration.
SIDEQUEST_MODEL=vertex_ai/gemini-3.5-flash-lite
VERTEX_LOCATION=global
